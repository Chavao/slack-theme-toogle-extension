{
  "manifest_version": 3,
  "name": "Slack Theme Toggle",
  "version": "1.0.0",
  "description": "Toggle Slack theme with a single click by updating the slack-client-theme localStorage key.",
  "permissions": ["scripting"],
  "host_permissions": ["https://app.slack.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Toggle Slack theme",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
